HOST=0.0.0.0
PORT=4000

# Probabilidade, de 0 a 1, de POST /pagamentos responder 503
FAILURE_RATE=0

# Para onde o resultado do pagamento e enviado, e o segredo da assinatura HMAC
WEBHOOK_URL=http://localhost:3333/api/v1/pagamentos/webhook
WEBHOOK_SECRET=troque-este-segredo

# Quantas vezes cada evento e entregue (mais de 1 exercita a idempotencia da API)
WEBHOOK_DELIVERIES=2
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_MS=500
WEBHOOK_TIMEOUT_MS=5000
